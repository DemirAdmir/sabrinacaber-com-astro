---
import Nav from '../components/Nav.astro';
import { translations, type Lang } from '../i18n/translations';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
}

const { lang = 'en', title, description } = Astro.props;
const t = translations[lang];
const pageTitle = title ?? t.meta.title;
const pageDesc = description ?? t.meta.description;

const SITE = 'https://www.sabrinacaber.com';
const langConfig: Record<Lang, { url: string; htmlLang: string; label: string }> = {
  en: { url: '/', htmlLang: 'en', label: 'English' },
  fr: { url: '/fr/', htmlLang: 'fr', label: 'Français' },
  bhs: { url: '/bhs/', htmlLang: 'bs', label: 'Bosanski' },
};
const skipLabel: Record<Lang, string> = {
  en: 'Skip to content',
  fr: 'Aller au contenu',
  bhs: 'Preskoči na sadržaj',
};
const otherLangs = (Object.keys(langConfig) as Lang[]).filter((l) => l !== lang);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={langConfig[lang].htmlLang} class="no-js">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  <meta name="description" content={pageDesc} />
  <meta name="author" content="Sabrina Caber" />
  <meta name="color-scheme" content="light dark" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={SITE + langConfig[lang].url} />
  <meta property="og:image" content={SITE + '/sabrina.png'} />
  <link rel="canonical" href={SITE + langConfig[lang].url} />
  <link rel="alternate" hreflang="en" href={SITE + '/'} />
  <link rel="alternate" hreflang="fr" href={SITE + '/fr/'} />
  <link rel="alternate" hreflang="bs" href={SITE + '/bhs/'} />
  <link rel="alternate" hreflang="hr" href={SITE + '/bhs/'} />
  <link rel="alternate" hreflang="sr" href={SITE + '/bhs/'} />
  <link rel="alternate" hreflang="x-default" href={SITE + '/'} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Inter:wght@400;500;600&display=swap"
  />
  <title>{pageTitle}</title>
</head>
<body>
  <a class="skip-link" href="#main">{skipLabel[lang]}</a>
  <Nav lang={lang} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <footer class="footer">
    <div class="container footer__inner">
      <div class="footer__brand">
        <a href={langConfig[lang].url} class="footer__logo">Sabrina Caber</a>
        <p class="footer__tagline">{t.footer.tagline}</p>
      </div>
      <nav class="footer__col" aria-label={t.footer.tagline}>
        <a class="link" href="#about">{t.footer.links.about}</a>
        <a class="link" href="#services">{t.footer.links.services}</a>
        <a class="link" href="#work">{t.footer.links.experience}</a>
        <a class="link" href="#contact">{t.footer.links.contact}</a>
      </nav>
      <div class="footer__col">
        <a class="link footer__email" href="mailto:sabrinacaber@gmail.com">sabrinacaber@gmail.com</a>
        <a class="link" href="https://linkedin.com/in/sabrinacaber" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        {otherLangs.map((l) => (
          <a class="link" href={langConfig[l].url} lang={langConfig[l].htmlLang} hreflang={langConfig[l].htmlLang}>
            {langConfig[l].label}
          </a>
        ))}
      </div>
    </div>
    <div class="container footer__bottom">
      <p>&copy; {year} Sabrina Caber. {t.footer.copyright}</p>
      <p>
        {t.footer.developedBy}
        <a class="link" href="https://admirdemir.com" target="_blank" rel="noopener noreferrer">admirdemir.com</a>
      </p>
    </div>
  </footer>
</body>
</html>

<style>
main:focus { outline: none; }

.footer {
  border-top: var(--rule-w) solid var(--color-rule);
  padding-block: var(--space-16) var(--space-8);
  font-size: var(--text-sm);
}

.footer__inner {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
  gap: var(--space-12);
}

.footer__logo {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  text-decoration: none;
  display: inline-block;
  margin-bottom: var(--space-2);
}

.footer__tagline { color: var(--color-ink-muted); }

.footer__col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-2);
}
.footer__col .link { padding-block: var(--space-1); }

.footer__email { overflow-wrap: anywhere; }

.footer__bottom {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: var(--space-2);
  margin-top: var(--space-12);
  padding-top: var(--space-6);
  border-top: var(--rule-w) solid var(--color-rule);
  color: var(--color-ink-muted);
  font-size: var(--text-xs);
}

@media (max-width: 48rem) {
  .footer__inner { grid-template-columns: minmax(0, 1fr); gap: var(--space-8); }
}
</style>
