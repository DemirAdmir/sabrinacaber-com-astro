---
import SectionTitle from './SectionTitle.astro';
import { translations, type Lang } from '../i18n/translations';
interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = translations[lang].services;
const altLang = lang === 'fr' ? 'en' : 'fr';
---

<section id="services" class="section services" aria-labelledby="services-title">
  <div class="container">
    <SectionTitle id="services" eyebrow={t.tag} line1={t.titleLine1} line2={t.titleLine2} alt={t.titleAlt} altLang={altLang} />

    <ol class="services__list">
      {t.items.map((s) => (
        <li class="service" data-reveal>
          <span class="service__num" aria-hidden="true">{s.number}</span>
          <h3 class="service__title">{s.title}</h3>
          <p class="service__desc">{s.description}</p>
          <ul class="service__tags">
            {s.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </li>
      ))}
    </ol>

    <div class="services__cta" data-reveal>
      <p class="services__question">{t.ctaQuestion}</p>
      <a href="#contact" class="btn btn--primary">
        {t.ctaBtn}
        <svg viewBox="0 0 24 24" aria-hidden="true" class="services__icon"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>
  </div>
</section>

<style>
.services__list { border-top: var(--rule-w) solid var(--color-rule-strong); }

.service {
  display: grid;
  grid-template-columns: 4rem minmax(0, 5fr) minmax(0, 6fr);
  grid-template-areas:
    'num title desc'
    'num title tags';
  column-gap: var(--space-8);
  row-gap: var(--space-4);
  padding-block: var(--space-8);
  border-bottom: var(--rule-w) solid var(--color-rule);
  transition: background-color var(--dur-base) var(--ease-out);
}
.service:hover { background: var(--color-paper-2); }

.service__num {
  grid-area: num;
  font-family: var(--font-display);
  font-size: var(--text-lg);
  color: var(--color-accent);
  padding-top: var(--space-2);
  padding-inline-start: var(--space-2);
}

.service__title {
  grid-area: title;
  font-size: var(--text-2xl);
  line-height: var(--leading-snug);
  transition: transform var(--dur-base) var(--ease-out);
}
.service:hover .service__title { transform: translateX(var(--space-2)); }

.service__desc { grid-area: desc; color: var(--color-ink-muted); }

.service__tags {
  grid-area: tags;
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}
.service__tags li {
  font-size: var(--text-xs);
  letter-spacing: 0.04em;
  padding: var(--space-1) var(--space-3);
  border: var(--rule-w) solid var(--color-rule);
  border-radius: var(--radius-sm);
  color: var(--color-ink-muted);
}

.services__cta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-6);
  margin-top: var(--space-12);
}
.services__question { font-family: var(--font-display); font-size: var(--text-xl); }
.services__icon { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

@media (max-width: 56rem) {
  .service {
    grid-template-columns: 2.5rem minmax(0, 1fr);
    grid-template-areas:
      'num title'
      'num desc'
      'num tags';
    column-gap: var(--space-4);
  }
  .service__num { padding-inline-start: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .service:hover .service__title { transform: none; }
}
</style>
