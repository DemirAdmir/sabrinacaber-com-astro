---
import SectionTitle from './SectionTitle.astro';
import { translations, type Lang } from '../i18n/translations';
interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = translations[lang].about;
const altLang = lang === 'fr' ? 'en' : 'fr';
---

<section id="about" class="section about" aria-labelledby="about-title">
  <div class="container">
    <SectionTitle id="about" eyebrow={t.tag} line1={t.titleLine1} line2={t.titleLine2} alt={t.titleAlt} altLang={altLang} />

    <div class="about__grid">
      <ul class="about__facts">
        {t.facts.map((f) => (
          <li class="fact" data-reveal>
            <span class="fact__value">{f.value}</span>
            <span class="fact__label">{f.label}</span>
          </li>
        ))}
      </ul>

      <div class="about__content">
        <p class="about__lead" data-reveal>{t.body1}</p>
        <p class="about__body" data-reveal>{t.body2}</p>

        <aside class="about__note" data-reveal>
          <svg viewBox="0 0 24 24" aria-hidden="true" class="about__note-icon"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
          <p>{t.note}</p>
        </aside>

        <ul class="about__skills" data-reveal>
          {t.skills.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
.about__grid {
  display: grid;
  grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  gap: clamp(var(--space-10), 6vw, var(--space-24));
  align-items: start;
}

.about__facts { display: grid; }

.fact {
  display: grid;
  gap: var(--space-1);
  padding-block: var(--space-5);
  border-top: var(--rule-w) solid var(--color-rule);
}
.fact:last-child { border-bottom: var(--rule-w) solid var(--color-rule); }

.fact__value {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  line-height: var(--leading-snug);
}
.fact__label { font-size: var(--text-sm); color: var(--color-ink-muted); }

.about__lead {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  line-height: var(--leading-snug);
  margin-bottom: var(--space-6);
}

.about__body { color: var(--color-ink-muted); margin-bottom: var(--space-8); }

.about__note {
  display: flex;
  gap: var(--space-3);
  align-items: flex-start;
  padding: var(--space-5);
  background: var(--color-paper-2);
  border-inline-start: var(--focus-w) solid var(--color-accent);
  margin-bottom: var(--space-8);
  font-size: var(--text-sm);
}
.about__note-icon {
  flex: none;
  width: 1.25rem;
  height: 1.25rem;
  margin-top: var(--space-1);
  fill: none;
  stroke: var(--color-accent);
  stroke-width: 1.75;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.about__skills {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2) var(--space-5);
  font-size: var(--text-sm);
  color: var(--color-ink-muted);
}
.about__skills li { display: inline-flex; align-items: center; gap: var(--space-5); }
.about__skills li + li::before {
  content: '';
  width: var(--space-1);
  height: var(--space-1);
  border-radius: 50%;
  background: var(--color-accent);
  margin-inline-start: calc(-1 * var(--space-5) + var(--space-2));
  margin-inline-end: calc(-1 * var(--space-5) + var(--space-2) + var(--space-1));
}

@media (max-width: 56rem) {
  .about__grid { grid-template-columns: minmax(0, 1fr); }
  .about__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-6); }
  .fact:nth-last-child(2) { border-bottom: var(--rule-w) solid var(--color-rule); }
}

@media (max-width: 24rem) {
  .about__facts { grid-template-columns: minmax(0, 1fr); }
  .fact:nth-last-child(2) { border-bottom: 0; }
}
</style>
