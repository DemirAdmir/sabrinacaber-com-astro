---
import { translations, type Lang } from '../i18n/translations';
interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = translations[lang].hero;
const phrases = t.phrases;
const codes: Record<Lang, string> = { en: 'EN', fr: 'FR', bhs: 'BHS' };
const htmlLang: Record<Lang, string> = { en: 'en', fr: 'fr', bhs: 'bs' };
const others = (Object.keys(phrases) as Lang[]).filter((l) => l !== lang);
---

<section id="home" class="hero" data-lang={lang}>
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="label hero__eyebrow">{t.eyebrow}</p>

      <h1 class="hero__title">
        <span class="hero__phrase" data-phrase={lang}>{phrases[lang]}</span>
        {others.map((l) => <span class="hero__sizer" aria-hidden="true" data-phrase={l}>{phrases[l]}</span>)}
        <span class="hero__morph" aria-hidden="true"></span>
      </h1>

      <p class="hero__route label" aria-hidden="true">
        <span data-route-from>{codes[others[0]]}</span>
        <svg viewBox="0 0 24 24" class="hero__arrow"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        <span data-route-to>{codes[lang]}</span>
      </p>

      <ul class="hero__versions">
        {others.map((l) => (
          <li><span class="label">{codes[l]}</span> <span lang={htmlLang[l]}>{phrases[l]}</span></li>
        ))}
      </ul>

      <p class="hero__subtitle">{t.subtitle}</p>

      <div class="hero__actions">
        <a href="#contact" class="btn btn--primary">
          {t.cta1}
          <svg viewBox="0 0 24 24" aria-hidden="true" class="hero__btn-icon"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a href="#services" class="btn btn--ghost">{t.cta2}</a>
      </div>
    </div>

    <div class="hero__split" aria-hidden="true"></div>

    <figure class="hero__portrait">
      <img
        src="/sabrina.png"
        alt="Sabrina Caber"
        width="807"
        height="807"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </div>
</section>

<style>
.hero {
  padding-block: clamp(var(--space-12), 8vw, var(--space-24)) var(--section-pad);
}

.hero__grid {
  display: grid;
  grid-template-columns: minmax(0, 7fr) auto minmax(0, 4fr);
  gap: clamp(var(--space-6), 4vw, var(--space-16));
  align-items: end;
}

.hero__eyebrow { margin-bottom: var(--space-6); }

.hero__title {
  display: grid;
  font-size: var(--text-display);
  font-weight: 350;
  line-height: var(--leading-tight);
  letter-spacing: -0.025em;
  margin-bottom: var(--space-4);
}
.hero__title > * { grid-area: 1 / 1; }
.hero__sizer { visibility: hidden; }
.hero__morph { color: var(--color-ink); }
.hero__morph:empty { display: none; }

/* While motion.js is morphing, the real phrase stays in the a11y tree but is painted transparent. */
.hero.is-morphing .hero__phrase { color: transparent; }

.hero__route {
  display: none;
  align-items: center;
  gap: var(--space-2);
  color: var(--color-accent);
  margin-bottom: var(--space-8);
}
:global(html.motion) .hero__route { display: inline-flex; }
.hero__arrow { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

.hero__versions {
  display: grid;
  gap: var(--space-1);
  margin-bottom: var(--space-8);
  font-family: var(--font-display);
  font-style: italic;
  font-size: var(--text-lg);
  color: var(--color-ink-muted);
}
.hero__versions .label { font-family: var(--font-body); font-style: normal; color: var(--color-accent); margin-inline-end: var(--space-2); }
:global(html.motion) .hero__versions { display: none; }

.hero__subtitle {
  font-size: var(--text-lg);
  color: var(--color-ink-muted);
  max-width: 48ch;
  margin-bottom: var(--space-8);
}

.hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
.hero__btn-icon { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

.hero__split {
  align-self: stretch;
  width: var(--rule-w);
  background: var(--color-rule);
}

.hero__portrait img {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  object-position: 50% 20%;
  filter: grayscale(1) contrast(1.05);
  transition: filter var(--dur-slow) var(--ease-out);
}
.hero__portrait:hover img { filter: none; }

@media (max-width: 56rem) {
  .hero__grid { grid-template-columns: minmax(0, 1fr); }
  .hero__split { display: none; }
  .hero__portrait { order: -1; max-width: 14rem; }
  .hero__portrait img { aspect-ratio: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .hero__portrait img { transition: none; }
}
</style>
