---
import { translations, type Lang } from '../i18n/translations';
interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = translations[lang].hero;
---

<canvas id="hero-canvas" aria-hidden="true"></canvas>

<section id="home" class="hero">
  <div class="hero__content container">
    <div class="hero__eyebrow fade-up">
      <span class="tag">{t.tag1}</span>
      <span class="tag">{t.tag2}</span>
    </div>

    <h1 class="hero__title">
      <span class="hero__title-line">{t.titleLine1}</span>
      <span class="hero__title-line hero__title-accent gradient-text">{t.titleLine2}</span>
    </h1>

    <p class="hero__subtitle fade-up">{t.subtitle}</p>

    <div class="hero__actions fade-up">
      <a href="#services" class="btn btn-primary"><span>{t.cta1}</span></a>
      <a href="#about" class="btn btn-outline"><span>{t.cta2}</span></a>
    </div>

    <div class="hero__scroll-indicator fade-in">
      <div class="hero__scroll-line"></div>
      <span>{t.scroll}</span>
    </div>
  </div>

  <div class="hero__marquee" aria-hidden="true">
    <div class="hero__marquee-track">
      {[...t.marquee, ...t.marquee].map((item) => (
        <>{item}<span class="sep" aria-hidden="true">/</span></>
      ))}
    </div>
  </div>
</section>

<style>
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
  padding-top: 100px;
}

/* Ambient glow behind hero text */
.hero::after {
  content: '';
  position: absolute;
  top: 20%;
  left: -10%;
  width: 60%;
  height: 60%;
  background: radial-gradient(ellipse at 30% 50%, rgba(200,169,110,0.07) 0%, transparent 65%);
  pointer-events: none;
  z-index: 1;
}

#hero-canvas {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
}

@media (max-width: 900px) {
  #hero-canvas { opacity: 0.35; }
}

.hero__content {
  position: relative;
  z-index: 2;
  max-width: 860px;
  padding-bottom: 8rem;
}

.hero__eyebrow {
  display: flex;
  gap: 0.75rem;
  margin-bottom: 2rem;
  flex-wrap: wrap;
  overflow: hidden;
}

.hero__title { margin-bottom: 2.5rem; }

.hero__title-line {
  display: block;
  letter-spacing: -0.03em;
  line-height: 1.05;
}

.hero__title-accent {
  font-style: italic;
  font-weight: 400;
}

.hero__subtitle {
  font-size: clamp(1rem, 1.4vw, 1.1rem);
  color: var(--clr-text-muted);
  margin-bottom: 3rem;
  max-width: 500px;
  line-height: 1.85;
  font-weight: 300;
}

.hero__actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.hero__scroll-indicator {
  position: absolute;
  bottom: 3rem;
  left: clamp(20px, 5vw, 60px);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
}

.hero__scroll-line {
  width: 1px;
  height: 56px;
  background: linear-gradient(to bottom, var(--clr-accent), transparent);
  animation: scrollPulse 2.5s ease-in-out infinite;
}

@keyframes scrollPulse {
  0%, 100% { transform: scaleY(1); opacity: 0.8; }
  50%       { transform: scaleY(0.5); opacity: 0.25; }
}

.hero__scroll-indicator span {
  font-size: 0.6rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--clr-text-dim);
  writing-mode: vertical-rl;
}

.hero__marquee {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  overflow: hidden;
  border-top: 1px solid var(--clr-border);
  background: rgba(8,8,12,0.75);
  backdrop-filter: blur(12px);
  padding: 0.9rem 0;
}

.hero__marquee-track {
  display: flex;
  gap: 2rem;
  width: max-content;
  animation: marquee 32s linear infinite;
}

.hero__marquee-track span,
.hero__marquee-track :global(span) {
  font-size: 0.65rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--clr-text-muted);
  white-space: nowrap;
  font-weight: 500;
}

.hero__marquee-track .sep,
.hero__marquee-track :global(.sep) {
  color: var(--clr-accent);
  letter-spacing: 0;
}

@keyframes marquee {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

@media (max-width: 768px) {
  .hero__title { font-size: clamp(1.9rem, 7vw, 2.8rem); }
}

@media (max-width: 600px) {
  .hero__scroll-indicator { display: none; }
  .hero__content { padding-bottom: 5rem; }
  .hero__subtitle { font-size: 0.9rem; }
  .hero__actions { gap: 0.75rem; flex-direction: column; }
  .hero__actions .btn { width: 100%; justify-content: center; padding: 0.9rem 1.5rem; font-size: 0.72rem; }
  .hero__eyebrow { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
  .hero__title { font-size: clamp(1.8rem, 8.5vw, 2.4rem); }
  .hero__title-line { word-break: break-word; overflow-wrap: break-word; }
}
</style>

