---
import { translations, type Lang } from '../i18n/translations';
interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = translations[lang].nav;

const langConfig: Record<Lang, { url: string; code: string; label: string }> = {
  en: { url: '/', code: 'en', label: 'EN' },
  fr: { url: '/fr/', code: 'fr', label: 'FR' },
  bhs: { url: '/bhs/', code: 'bs', label: 'BHS' },
};
const ui: Record<Lang, { menu: string; main: string; language: string }> = {
  en: { menu: 'Menu', main: 'Main navigation', language: 'Language' },
  fr: { menu: 'Menu', main: 'Navigation principale', language: 'Langue' },
  bhs: { menu: 'Meni', main: 'Glavna navigacija', language: 'Jezik' },
};
const links = [
  { href: '#about', label: t.about },
  { href: '#services', label: t.services },
  { href: '#process', label: t.process },
  { href: '#work', label: t.experience },
  { href: '#contact', label: t.contact },
];
const langs = Object.keys(langConfig) as Lang[];
---

<header class="nav" id="nav">
  <div class="container nav__bar">
    <a href={langConfig[lang].url} class="nav__logo">Sabrina Caber</a>

    <nav class="nav__links" aria-label={ui[lang].main}>
      {links.map((l) => <a class="nav__link" href={l.href}>{l.label}</a>)}
    </nav>

    <div class="nav__right">
      <div class="nav__lang" role="group" aria-label={ui[lang].language}>
        {langs.map((l) =>
          l === lang ? (
            <span class="nav__lang-item is-current" aria-current="true">{langConfig[l].label}</span>
          ) : (
            <a class="nav__lang-item" href={langConfig[l].url} hreflang={langConfig[l].code} lang={langConfig[l].code}>{langConfig[l].label}</a>
          )
        )}
      </div>
      <a href="#contact" class="btn btn--primary nav__cta">{t.cta}</a>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
        <span class="sr-only">{ui[lang].menu}</span>
        <svg class="nav__icon nav__icon--open" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg class="nav__icon nav__icon--close" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>
    </div>
  </div>

  <div class="nav__mobile" id="mobile-menu" hidden>
    <nav class="container nav__mobile-links" aria-label={ui[lang].main}>
      {links.map((l) => <a class="nav__mobile-link" href={l.href}>{l.label}</a>)}
      <a href="#contact" class="btn btn--primary nav__mobile-cta">{t.cta}</a>
    </nav>
  </div>
</header>

<style>
.nav {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--color-paper);
  border-bottom: var(--rule-w) solid var(--color-rule);
}

.nav__bar {
  display: flex;
  align-items: center;
  gap: var(--space-6);
  min-height: var(--header-h);
}

.nav__logo {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  text-decoration: none;
  white-space: nowrap;
  margin-inline-end: auto;
}

.nav__links { display: flex; gap: var(--space-6); }

.nav__link {
  font-size: var(--text-sm);
  text-decoration: none;
  color: var(--color-ink-muted);
  padding-block: var(--space-2);
  border-bottom: var(--rule-w) solid transparent;
  transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
}
.nav__link:hover { color: var(--color-ink); border-color: var(--color-accent); }

.nav__right { display: flex; align-items: center; gap: var(--space-4); }

.nav__lang { display: flex; gap: var(--space-1); font-size: var(--text-xs); letter-spacing: var(--tracking-caps); }

.nav__lang-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: var(--control-min);
  min-height: var(--control-min);
  padding-inline: var(--space-1);
  text-decoration: none;
  color: var(--color-ink-muted);
}
a.nav__lang-item:hover { color: var(--color-accent); }
.nav__lang-item.is-current { color: var(--color-ink); font-weight: 600; text-decoration: underline; text-decoration-color: var(--color-accent); text-underline-offset: 0.35em; }

.nav__toggle {
  display: none;
  align-items: center;
  justify-content: center;
  width: var(--control-min);
  height: var(--control-min);
  background: transparent;
  border: var(--rule-w) solid var(--color-rule-strong);
  border-radius: var(--radius-sm);
  color: var(--color-ink);
  cursor: pointer;
}
.nav__toggle:hover { background: var(--color-paper-2); }
.nav__toggle:active { background: var(--color-rule); }

.nav__icon { width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
.nav__icon--close { display: none; }
.nav__toggle[aria-expanded='true'] .nav__icon--open { display: none; }
.nav__toggle[aria-expanded='true'] .nav__icon--close { display: block; }

.nav__mobile { border-top: var(--rule-w) solid var(--color-rule); background: var(--color-paper); }

.nav__mobile-links {
  display: flex;
  flex-direction: column;
  padding-block: var(--space-4) var(--space-8);
}

.nav__mobile-link {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  text-decoration: none;
  padding-block: var(--space-3);
  border-bottom: var(--rule-w) solid var(--color-rule);
}
.nav__mobile-link:hover { color: var(--color-accent); }

.nav__mobile-cta { margin-top: var(--space-6); align-self: flex-start; }

@media (max-width: 62rem) {
  .nav__links, .nav__cta { display: none; }
  .nav__toggle { display: inline-flex; }
}

@media (max-width: 22rem) {
  .nav__bar { gap: var(--space-2); }
  .nav__right { gap: var(--space-1); }
  .nav__lang-item { min-width: 2rem; }
}
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    window.matchMedia('(min-width: 62.0625rem)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
