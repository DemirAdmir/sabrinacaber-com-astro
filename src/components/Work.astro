---
import SectionTitle from './SectionTitle.astro';
import { translations, type Lang } from '../i18n/translations';
interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = translations[lang].work;
const altLang = lang === 'fr' ? 'en' : 'fr';
---

<section id="work" class="section work" aria-labelledby="work-title">
  <div class="container">
    <SectionTitle id="work" eyebrow={t.tag} line1={t.titleLine1} line2={t.titleLine2} alt={t.titleAlt} altLang={altLang} />

    <ol class="work__list">
      {t.items.map((p) => (
        <li class="entry" data-reveal>
          <p class="entry__year">{p.year}</p>
          <div class="entry__head">
            <h3 class="entry__title">{p.title}</h3>
            <p class="entry__org">{p.category}</p>
            <p class={`entry__type entry__type--${p.type}`}>{p.type === 'education' ? t.badgeEdu : t.badgeExp}</p>
          </div>
          <p class="entry__desc">{p.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
.work__list { border-top: var(--rule-w) solid var(--color-rule-strong); }

.entry {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(0, 4fr) minmax(0, 6fr);
  gap: var(--space-8);
  padding-block: var(--space-8);
  border-bottom: var(--rule-w) solid var(--color-rule);
}

.entry__year {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  color: var(--color-accent);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.entry__title { font-size: var(--text-xl); line-height: var(--leading-snug); margin-bottom: var(--space-1); }

.entry__org { color: var(--color-ink-muted); font-size: var(--text-sm); margin-bottom: var(--space-3); }

.entry__type {
  display: inline-block;
  font-size: var(--text-xs);
  font-weight: 500;
  letter-spacing: var(--tracking-caps);
  text-transform: uppercase;
  color: var(--color-ink-muted);
  padding: var(--space-1) var(--space-2);
  border: var(--rule-w) solid var(--color-rule);
  border-radius: var(--radius-sm);
}
.entry__type--education { border-style: dashed; }

.entry__desc { color: var(--color-ink-muted); }

@media (max-width: 56rem) {
  .entry { grid-template-columns: minmax(0, 1fr); gap: var(--space-3); }
}
</style>
