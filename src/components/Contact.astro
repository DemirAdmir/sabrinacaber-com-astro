---
import SectionTitle from './SectionTitle.astro';
import { translations, type Lang } from '../i18n/translations';
interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = translations[lang].contact;
const f = t.form;
const altLang = lang === 'fr' ? 'en' : 'fr';
const messages = JSON.stringify({ errors: f.errors, sending: f.sending, success: f.successMsg, submit: f.submitBtn });
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="container">
    <SectionTitle id="contact" eyebrow={t.tag} line1={t.titleLine1} line2={t.titleLine2} alt={t.titleAlt} altLang={altLang} />

    <div class="contact__grid">
      <div class="contact__info" data-reveal>
        <p class="contact__body">{t.body}</p>

        <dl class="contact__details">
          <div>
            <dt class="label">{t.labels.email}</dt>
            <dd><a class="link contact__value" href="mailto:sabrinacaber@gmail.com">sabrinacaber@gmail.com</a></dd>
          </div>
          <div>
            <dt class="label">{t.labels.phone}</dt>
            <dd><a class="link contact__value" href="tel:+38761997090">+387 61 997 090</a></dd>
          </div>
          <div>
            <dt class="label">{t.labels.languages}</dt>
            <dd class="contact__value">{t.languagesValue}</dd>
          </div>
          <div>
            <dt class="label">{t.labels.availability}</dt>
            <dd class="contact__value">{t.availableText}</dd>
          </div>
        </dl>

        <div class="contact__links">
          <a class="btn btn--ghost" href={t.calendly.url} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="contact__icon"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
            {t.calendly.label}
          </a>
          {t.social.map((s) => (
            <a class="link contact__social" href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
          ))}
        </div>
        <p class="contact__small">{t.calendly.note}</p>
      </div>

      <form
        class="contact__form"
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        novalidate
        data-messages={messages}
        data-reveal
      >
        <input type="hidden" name="form-name" value="contact" />
        <input type="hidden" name="lang" value={lang} />
        <p class="contact__hp" aria-hidden="true">
          <label>Leave empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div class="field">
          <label class="field__label" for="cf-name">{f.nameLabel}</label>
          <input class="field__input" id="cf-name" name="name" type="text" autocomplete="name" placeholder={f.namePlaceholder} required aria-describedby="cf-name-error" />
          <p class="field__error" id="cf-name-error"></p>
        </div>

        <div class="field">
          <label class="field__label" for="cf-email">{f.emailLabel}</label>
          <input class="field__input" id="cf-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder={f.emailPlaceholder} required aria-describedby="cf-email-error" />
          <p class="field__error" id="cf-email-error"></p>
        </div>

        <div class="field">
          <label class="field__label" for="cf-service">{f.serviceLabel}</label>
          <select class="field__input field__select" id="cf-service" name="service">
            <option value="">{f.servicePlaceholder}</option>
            {f.serviceOptions.map((o) => <option value={o.value}>{o.label}</option>)}
          </select>
        </div>

        <div class="field">
          <label class="field__label" for="cf-message">{f.messageLabel}</label>
          <textarea class="field__input field__textarea" id="cf-message" name="message" rows="5" placeholder={f.messagePlaceholder} required aria-describedby="cf-message-error"></textarea>
          <p class="field__error" id="cf-message-error"></p>
        </div>

        <button type="submit" class="btn btn--primary contact__submit">
          <span class="contact__submit-label">{f.submitBtn}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" class="contact__icon contact__send"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          <svg viewBox="0 0 24 24" aria-hidden="true" class="contact__icon contact__spinner"><path d="M21 12a9 9 0 1 1-6.22-8.56" /></svg>
        </button>

        <p class="contact__status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<style>
.contact__grid {
  display: grid;
  grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
  gap: clamp(var(--space-10), 6vw, var(--space-24));
  align-items: start;
}

.contact__body { font-size: var(--text-lg); margin-bottom: var(--space-8); }

.contact__details { display: grid; margin-bottom: var(--space-8); }
.contact__details > div {
  display: grid;
  grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
  gap: var(--space-4);
  align-items: baseline;
  padding-block: var(--space-3);
  border-top: var(--rule-w) solid var(--color-rule);
}
.contact__details > div:last-child { border-bottom: var(--rule-w) solid var(--color-rule); }
.contact__value { overflow-wrap: anywhere; }

.contact__links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-6); }
.contact__social { padding-block: var(--space-2); }
.contact__small { margin-top: var(--space-3); font-size: var(--text-sm); color: var(--color-ink-muted); }

.contact__icon { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

/* Form */
.contact__form {
  position: relative;
  display: grid;
  gap: var(--space-5);
  padding: clamp(var(--space-5), 4vw, var(--space-10));
  background: var(--color-paper-2);
  border: var(--rule-w) solid var(--color-rule);
}

.contact__hp { position: absolute; left: 0; top: 0; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); }

.field { display: grid; gap: var(--space-2); min-width: 0; }
.field__label { font-size: var(--text-sm); font-weight: 500; }

.field__input {
  inline-size: 100%;
  min-inline-size: 0;
  min-height: var(--control-min);
  padding: var(--space-3) var(--space-4);
  font: inherit;
  font-size: var(--text-base);
  color: var(--color-ink);
  background: var(--color-paper);
  border: var(--rule-w) solid var(--color-rule-strong);
  border-radius: var(--radius-sm);
  transition: border-color var(--dur-fast) var(--ease-out);
}
.field__input::placeholder { color: var(--color-ink-muted); opacity: 0.8; }
.field__input:hover { border-color: var(--color-ink); }
.field__input:focus-visible { outline: var(--focus-w) solid var(--color-focus); outline-offset: 0; border-color: var(--color-focus); }
.field__input[aria-invalid='true'] { border-color: var(--color-error); box-shadow: inset 0 0 0 var(--rule-w) var(--color-error); }
.field__input:disabled { opacity: 0.5; pointer-events: none; }
.field__textarea { resize: vertical; min-height: 8rem; }
.field__select {
  appearance: none;
  background-image:
    linear-gradient(45deg, transparent 50%, currentColor 50%),
    linear-gradient(135deg, currentColor 50%, transparent 50%);
  background-position: calc(100% - 1.25rem) 55%, calc(100% - 0.9rem) 55%;
  background-size: 0.35rem 0.35rem;
  background-repeat: no-repeat;
  padding-inline-end: var(--space-10);
}

.field__error { font-size: var(--text-sm); color: var(--color-error); font-weight: 500; }
.field__error:empty { display: none; }

.contact__submit { justify-self: start; }
.contact__spinner { display: none; }
.contact__submit[aria-busy='true'] { pointer-events: none; }
.contact__submit[aria-busy='true'] .contact__send { display: none; }
.contact__submit[aria-busy='true'] .contact__spinner { display: block; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(1turn); } }

.contact__status { font-size: var(--text-sm); font-weight: 500; }
.contact__status:empty { display: none; }
.contact__status.is-error { color: var(--color-error); }

@media (max-width: 56rem) {
  .contact__grid { grid-template-columns: minmax(0, 1fr); }
}
@media (max-width: 26rem) {
  .contact__details > div { grid-template-columns: minmax(0, 1fr); gap: var(--space-1); }
}
@media (prefers-reduced-motion: reduce) {
  .contact__submit[aria-busy='true'] .contact__spinner { animation-duration: 2.4s; }
}
</style>

<script>
  import { validate, submitContact } from '../scripts/contact-form.js';

  const form = document.querySelector<HTMLFormElement>('form.contact__form');
  if (form) {
    const msg = JSON.parse(form.dataset.messages || '{}');
    const btn = form.querySelector<HTMLButtonElement>('.contact__submit')!;
    const label = btn.querySelector<HTMLElement>('.contact__submit-label')!;
    const status = form.querySelector<HTMLElement>('.contact__status')!;
    const fields = {
      name: form.querySelector<HTMLInputElement>('#cf-name')!,
      email: form.querySelector<HTMLInputElement>('#cf-email')!,
      message: form.querySelector<HTMLTextAreaElement>('#cf-message')!,
    };
    type Key = keyof typeof fields;
    const keys = Object.keys(fields) as Key[];
    const values = () => ({ name: fields.name.value, email: fields.email.value, message: fields.message.value });

    const setError = (key: Key, on: boolean) => {
      const el = fields[key];
      el.setAttribute('aria-invalid', String(on));
      document.getElementById(`${el.id}-error`)!.textContent = on ? msg.errors[key] : '';
    };

    keys.forEach((key) => {
      fields[key].addEventListener('input', () => {
        if (fields[key].getAttribute('aria-invalid') === 'true') setError(key, key in validate(values()));
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      status.classList.remove('is-error');

      const errors = validate(values());
      keys.forEach((k) => setError(k, k in errors));
      const first = keys.find((k) => k in errors);
      if (first) { fields[first].focus(); return; }

      btn.setAttribute('aria-busy', 'true');
      label.textContent = msg.sending;
      try {
        await submitContact(Object.fromEntries(new FormData(form)) as Record<string, string>);
        form.reset();
        status.textContent = msg.success;
      } catch {
        status.classList.add('is-error');
        status.textContent = msg.errors.network;
      } finally {
        btn.removeAttribute('aria-busy');
        label.textContent = msg.submit;
      }
    });
  }
</script>
